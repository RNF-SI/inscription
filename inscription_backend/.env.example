DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL (ex.) : DATABASE_URL=postgres://USER:PASS@HOST:5432/DBNAME
# Après changement : pip install -r requirements.txt (psycopg2-binary + psycopg inclus)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Utilisé par le backend (JWT, token, Admin API) ET exposé au front via GET /api/auth/keycloak-config/
# Pas de commentaire en fin de ligne sur une variable (django-environ ne les ignore pas).
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=master
KEYCLOAK_ADMIN_CLIENT_ID=inscription-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_APP_CLIENT_ID=inscription-spa
KEYCLOAK_APP_CLIENT_SECRET=
KEYCLOAK_SYNC_ENABLED=0
# Délai (s) des appels HTTP vers Keycloak sur le chemin des requêtes API
KEYCLOAK_HTTP_TIMEOUT=10
# Tolérance (s) d'écart d'horloge entre Keycloak et ce serveur à la validation
# des jetons. 60 s absorbent la dérive ordinaire sans masquer un décrochage.
KEYCLOAK_LEEWAY=60

KEYCLOAK_GROUP_ORGANISMES=organismes
KEYCLOAK_GROUP_RESERVES=reserves
KEYCLOAK_GROUP_APPLICATIONS=applications

FRONTEND_PUBLIC_URL=http://localhost:4200
# Vignettes applications (défaut : inscription_backend/media/application-images)
# APPLICATION_IMAGES_DIR=/var/lib/inscription/application-images
SUPERADMIN_NOTIFY_EMAILS=admin@example.org
# Prévient les référents d'une réserve qu'un membre vient de la rejoindre
# (notification in-app + e-mail). Coupé par défaut : pendant la bascule, chaque
# compte repris rejoint ses réserves et les référents recevraient la pile d'un coup.
# RESERVE_NEW_MEMBER_NOTIFY_ENABLED=1

# Base historique (geonature_global) : schémas utilisateurs et complement_rnf.
# Sert à l'import initial ET à l'écriture miroir permanente.
LEGACY_DATABASE_URL=
# Répercute dans la base historique toute mutation de compte. À laisser actif tant
# que les applications RNF y lisent leurs utilisateurs. Défaut : actif dès que
# LEGACY_DATABASE_URL est renseigné.
# LEGACY_WRITE_ENABLED=1
# Écrit aussi le md5 dans t_roles.pass, en plus du bcrypt dans pass_plus.
# ACTIF PAR DÉFAUT : les comptes les plus récents de la production en portent un,
# donc quelque chose le lit encore. Ne poser 0 qu'après avoir vérifié le contraire :
#   SELECT count(*) FROM utilisateurs.t_roles WHERE pass IS NOT NULL;
# Attention : écrire « LEGACY_WRITE_PASS_MD5=0 » en croyant expliciter le défaut
# DÉSACTIVE l'écriture du md5.
# LEGACY_WRITE_PASS_MD5=1
# Groupes auxquels rattacher tout compte créé (utilisateurs.cor_roles).
# 69 = Grp_all sur l'installation RNF, que porte la quasi-totalité des comptes.
# LEGACY_DEFAULT_GROUP_IDS=69
# id_application dans utilisateurs.t_applications. Désactivé (0) : la production
# n'alimente plus cor_role_app_profil à la validation. 6 pour rétablir le droit INS.
# LEGACY_INSCRIPTION_APP_ID=0

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@localhost

# Formulaire de contact mutualisé (routes /api/contact/)
# Destinataires autorisés, séparés par des virgules (boîtes Zammad).
# Vide = route désactivée (503).
CONTACT_ALLOWED_RECIPIENTS=support@reserves-naturelles.org
CONTACT_THROTTLE_RATE=10/hour
