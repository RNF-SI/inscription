# Synchronisation du référentiel réserves / organismes depuis l'API de RADIS.
#
# Installation : voir docs/runbook-cutover.txt, § 2.1.
# Les chemins et l'utilisateur supposent le déploiement de production
# (/home/inscription/inscription) ; les adapter sinon.

[Unit]
Description=Synchronise le référentiel réserves et organismes depuis RADIS
Documentation=https://github.com/RNF-SI/inscription/blob/main/inscription_backend/docs/runbook-cutover.txt
# La commande ne fait que des requêtes HTTPS et du SQL : sans réseau elle échoue
# immédiatement, autant attendre qu'il soit là.
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=inscription
Group=inscription
WorkingDirectory=/home/inscription/inscription/inscription_backend
# --declencheur=minuteur n'a qu'un effet : la trace du passage le dit, et
# l'administration peut afficher « dernier passage nocturne » plutôt que de
# confondre avec un clic.
ExecStart=/home/inscription/inscription/inscription_backend/venv/bin/python manage.py synchro_radis --declencheur=minuteur

# Un passage idempotent tient en une dizaine de secondes. La marge couvre le cas
# du premier passage après une longue interruption, qui crée des organismes dans
# la base historique — et chaque création y déclenche une chaîne de triggers.
TimeoutStartSec=1800

# La commande n'a besoin que de son dossier, des deux bases et du réseau.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectControlGroups=yes
